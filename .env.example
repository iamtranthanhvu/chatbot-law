# Copy to .env (make setup does this) and adjust.

# --- Data stores (compose.dev.yml) ---
DATABASE_URL=postgresql+asyncpg://lawqa:lawqa@127.0.0.1:5432/lawqa
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=lawqa_chunks
REDIS_URL=redis://127.0.0.1:6379/0

# --- Model server (embedding + rerank) ---
MODEL_SERVER_URL=http://127.0.0.1:8001
# model-server itself (MS_ prefix); DEVICE=auto picks cuda > mps > cpu
MS_DEVICE=auto
MS_EMBED_MODEL=BAAI/bge-m3
MS_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- LLM (OpenAI-compatible: Ollama in dev, vLLM in prod) ---
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b

# --- Ingestion ---
CHUNK_MAX_TOKENS=512
TOKENIZER_NAME=BAAI/bge-m3

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
