# Copy to .env (make setup does this) and adjust.

# --- Data stores (compose.dev.yml) ---
DATABASE_URL=postgresql+asyncpg://lawqa:lawqa@127.0.0.1:5432/lawqa
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=lawqa_chunks
REDIS_URL=redis://127.0.0.1:6379/0

# --- Model server (embedding + rerank) ---
MODEL_SERVER_URL=http://127.0.0.1:8001
# model-server itself (MS_ prefix); DEVICE=auto picks cuda > mps > cpu
MS_DEVICE=auto
MS_EMBED_MODEL=BAAI/bge-m3
MS_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- LLM (OpenAI-compatible: Ollama in dev, vLLM in prod) ---
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
# ollama: native /api/chat (only way to turn Qwen3 thinking off on Ollama) · openai: vLLM
LLM_API_STYLE=ollama
# Ollama context window; must be >= CONTEXT_MAX_TOKENS + MAX_ANSWER_TOKENS + 1024
LLM_NUM_CTX=8192
LLM_MODEL=qwen3:8b

# --- Evaluation judge (must differ from LLM_MODEL unless --allow-self-judge) ---
JUDGE_BASE_URL=http://127.0.0.1:11434
JUDGE_MODEL=qwen3:8b
JUDGE_API_STYLE=ollama

# --- Retrieval ---
# dense | bm25 | hybrid, optionally followed by +rerank
RETRIEVAL_MODE=hybrid+rerank
# put articles named in the question ("Điều 100", "khoản 1 Điều 126") first
CITATION_LOOKUP=true
RERANK_TOP_N=8
# candidates sent to the reranker: ~1s each on an M1 GPU, <1s for all 40 on a server GPU
RERANK_CANDIDATES=40
# best reranker score below this → "không đủ căn cứ" without calling the LLM.
# Seed set: out-of-scope 0.0009–0.0073, lowest valid question 0.0062 → 0.005 refuses no valid one.
RERANK_MIN_SCORE=0.005

# --- Generation ---
CONTEXT_MAX_TOKENS=6000
MAX_ANSWER_TOKENS=1024
MAX_CONTEXT_CHUNKS=8

# --- Ingestion ---
CHUNK_MAX_TOKENS=512
TOKENIZER_NAME=BAAI/bge-m3

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
